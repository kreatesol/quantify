# Copy to .env for local development.
DATABASE_URL=postgres://quantify:quantify@localhost:5432/quantify
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
OTP_SECRET=change-me-to-another-long-random-string
# Countries whose numbers can sign up. US is allowed during development.
ALLOWED_PHONE_COUNTRIES=IN,US
# console prints codes to the server log; sns sends real SMS through AWS SNS.
SMS_PROVIDER=console
AWS_REGION=us-east-1
