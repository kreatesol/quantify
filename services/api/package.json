{
  "name": "@quantify/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.1157.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/jwt": "^10.0.0",
    "@quantify/shared": "workspace:*",
    "fastify": "^5.6.0",
    "pg": "^8.16.0",
    "tsx": "^4.20.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "vitest": "^4.0.0"
  }
}
